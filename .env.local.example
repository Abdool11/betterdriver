# ─────────────────────────────────────────────────────────────────────────────
# BetterDriver — betterdriver.co.za
# Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file to .env.local  →  cp .env.local.example .env.local
#   2. Fill in every value marked REPLACE_ME
#   3. NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Shared project for the full TAG ecosystem (TAG + GFA + BD)
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://khzctzixeghppwwnzsdq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_your_supabase_service_role_key

# ── JWT (Driver Sessions) ──────────────────────────────────────────────────────
# Used to sign driver session tokens (persistent magic link model — no passwords)
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_ME_run_openssl_rand_-hex_32
# Alias used in some auth routes — set to the same value as JWT_SECRET
BD_JWT_SECRET=REPLACE_ME_same_as_JWT_SECRET

# ── Moodle Integration ─────────────────────────────────────────────────────────
# Found in: Moodle Admin → Site Administration → Plugins → Web Services → Manage tokens
# MOODLE_URL: Base URL of your Moodle instance (no trailing slash)
# MOODLE_TOKEN: Web service token with required capabilities (see MOODLE_SETUP.md)
# MOODLE_DRIVER_PROGRAMME_COURSE_ID: Moodle course ID for "Professional Truck Driver"
# MOODLE_ECO_DRIVER_COURSE_ID: Moodle course ID for "Eco-Driver Training"
# MOODLE_WEBHOOK_SECRET: Random string set in Moodle → Local plugins → BD Webhook
# MOODLE_POLL_SECRET: Random string used to authenticate the cron poll endpoint
MOODLE_URL=https://REPLACE_ME_your_moodle_domain.com
MOODLE_TOKEN=REPLACE_ME_moodle_web_service_token
MOODLE_DRIVER_PROGRAMME_COURSE_ID=REPLACE_ME_course_id_from_moodle_url
MOODLE_ECO_DRIVER_COURSE_ID=REPLACE_ME_course_id_from_moodle_url
MOODLE_WEBHOOK_SECRET=REPLACE_ME_run_openssl_rand_-hex_32
MOODLE_POLL_SECRET=REPLACE_ME_run_openssl_rand_-hex_32

# ── WhatsApp (Meta Graph API) ──────────────────────────────────────────────────
# Found in: Meta Developer Portal → Your App → WhatsApp → API Setup
# Same credentials as GFA — shared WhatsApp Business account
# NOTE: Both sets of variable names are used — set all four to the correct values
WHATSAPP_ACCESS_TOKEN=REPLACE_ME_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME_meta_phone_number_id
META_WA_TOKEN=REPLACE_ME_same_as_WHATSAPP_ACCESS_TOKEN
META_WA_PHONE_NUMBER_ID=REPLACE_ME_same_as_WHATSAPP_PHONE_NUMBER_ID
META_WA_API_VERSION=v19.0

# ── Bunny.net (Video CDN — Course Videos) ─────────────────────────────────────
# Found in: Bunny.net Dashboard → Stream → Library → API
# Used to serve course videos to drivers via the BD portal
BUNNY_CDN_HOSTNAME=REPLACE_ME_vz-xxxxxx.b-cdn.net

# ── Site URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://betterdriver.co.za
NEXT_PUBLIC_BD_URL=https://betterdriver.co.za
NEXT_PUBLIC_GFA_URL=https://www.greenfreightacademy.co.za
NEXT_PUBLIC_TAG_URL=https://www.transportactiongroup.com
NEXT_PUBLIC_ZERO_AFRICA_URL=https://www.zeroafrica.org

# ── Branding ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LOGO_URL=https://betterdriver.co.za/logo.png
NEXT_PUBLIC_SUPPORT_EMAIL=support@betterdriver.co.za
NEXT_PUBLIC_SUPPORT_PHONE=+27 000 000 0000

# ── Push notifications (optional; WhatsApp remains the fallback) ──────────────
# Generate a VAPID key pair only when beginning the push-notification pilot.
# Keep ENABLE_PUSH_NOTIFICATIONS=false until preview and real-device tests pass.
VAPID_PUBLIC_KEY=REPLACE_ME_generated_vapid_public_key
VAPID_PRIVATE_KEY=REPLACE_ME_generated_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_ME_same_as_VAPID_PUBLIC_KEY
ENABLE_PUSH_NOTIFICATIONS=false

# ── Port ───────────────────────────────────────────────────────────────────────
PORT=3002
